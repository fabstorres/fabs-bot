#!/usr/bin/env bun
/**
 * control-fabs: launch, inspect, drive and tear down an isolated Fabs Bot instance for verification.
 * Run `control-fabs help` for usage. Everything it starts is recorded in the run's state.json and
 * killed by `control-fabs cleanup`; evidence lives in <repo>/.verify/artifacts/<run> and survives cleanup.
 */
import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, statSync, symlinkSync, writeFileSync } from "node:fs";
import { createServer } from "node:net";
import { homedir, tmpdir } from "node:os";
import { dirname, isAbsolute, join, resolve } from "node:path";
import { redact, risky } from "./privacy.mjs";

const REPO = resolve(import.meta.dir, "../../../..");
const HOME = process.env.FABS_VERIFY_HOME ?? join(process.env.XDG_RUNTIME_DIR ?? tmpdir(), "fabs-verify");
const ARTIFACTS_ROOT = join(REPO, ".verify/artifacts");
mkdirSync(HOME, { recursive: true });

type State = {
  runId: string;
  pid: number;
  port: number;
  url: string;
  tailnet: boolean;
  runDir: string;
  dataDir: string;
  workRoot: string;
  artifacts: string;
  rev: string;
  startedAt: string;
  shimDir?: string;
  oauthMcp?: { pid: number; port: number };
  browser?: { pid: number; cdpPort: number; viewport: string; desktop?: { compositorPid: number; inspectPort: number } };
};

const argv = process.argv.slice(2);
const positional: string[] = [];
const flags: Record<string, string | true> = {};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]!;
  if (a === "--") {
    positional.push(...argv.slice(i + 1));
    break;
  }
  if (a.startsWith("--")) {
    const key = a.slice(2);
    const next = argv[i + 1];
    if (next !== undefined && !next.startsWith("--")) {
      flags[key] = next;
      i++;
    } else flags[key] = true;
  } else positional.push(a);
}
const flag = (k: string) => (typeof flags[k] === "string" ? (flags[k] as string) : undefined);

function die(msg: string, code = 1): never {
  console.error(`control-fabs: ${msg}`);
  process.exit(code);
}

function currentRunId(): string | null {
  const explicit = flag("run") ?? process.env.FABS_VERIFY_RUN;
  if (explicit) return explicit;
  const p = join(HOME, "current");
  return existsSync(p) ? readFileSync(p, "utf8").trim() : null;
}
function loadState(required = true): State | null {
  const id = currentRunId();
  const p = id ? join(HOME, id, "state.json") : null;
  if (!p || !existsSync(p)) {
    if (required) die("no verification instance; run `control-fabs launch` first");
    return null;
  }
  return JSON.parse(readFileSync(p, "utf8"));
}
function saveState(s: State) {
  writeFileSync(join(s.runDir, "state.json"), JSON.stringify(s, null, 2));
}
const alive = (pid: number) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
};
const cmdline = (pid: number) => {
  try {
    return readFileSync(`/proc/${pid}/cmdline`, "utf8").replace(/\0/g, " ");
  } catch {
    return "";
  }
};
function freePort(start: number): Promise<number> {
  return new Promise((res) => {
    const srv = createServer();
    srv.once("error", () => res(freePort(start + 1)));
    srv.listen(start, "127.0.0.1", () => srv.close(() => res(start)));
  });
}
async function sh(cmd: string[], cwd = REPO) {
  const p = Bun.spawn(cmd, { cwd, stdout: "pipe", stderr: "pipe" });
  const [out, err] = [await new Response(p.stdout).text(), await new Response(p.stderr).text()];
  return { code: await p.exited, out: out.trim(), err: err.trim() };
}
function artifactPath(s: State, p: string) {
  const full = isAbsolute(p) ? p : join(s.artifacts, p);
  mkdirSync(dirname(full), { recursive: true });
  return full;
}

async function api(s: State, method: string, path: string, body?: unknown) {
  const res = await fetch(s.url + path, {
    method,
    headers: body !== undefined ? { "content-type": "application/json" } : undefined,
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });
  const text = await res.text();
  let data: any = text;
  try {
    data = JSON.parse(text);
  } catch {}
  return { status: res.status, data };
}

async function startServer(s: State) {
  const env = [
    `FABS_PORT=${s.port}`,
    `FABS_DATA_DIR=${s.dataDir}`,
    `FABS_WORK_ROOT=${s.workRoot}`,
    ...(s.tailnet ? [] : ["FABS_HOST=127.0.0.1"]),
    ...(s.shimDir
      ? [`PATH='${join(s.shimDir, "bin")}:${process.env.PATH}'`, `FABS_SHIM_DIR='${s.shimDir}'`, `FABS_SHIM_REAL='${readFileSync(join(s.shimDir, "real"), "utf8")}'`]
      : []),
  ];
  const log = join(s.runDir, "server.log");
  // setsid gives the server its own process group, so cleanup can stop it and every bot CLI it spawned.
  const start = await sh(["sh", "-c", `env ${env.join(" ")} setsid bun server/index.ts >> '${log}' 2>&1 < /dev/null & echo $!`]);
  s.pid = Number(start.out);
  saveState(s);
  const deadline = Date.now() + 30_000;
  while (Date.now() < deadline) {
    if (!alive(s.pid)) die(`server exited; log:\n${redact(readFileSync(log, "utf8"))}`);
    const ok = await fetch(s.url + "/api/host").then((r) => r.ok).catch(() => false);
    if (ok) return;
    await Bun.sleep(300);
  }
  die("server did not answer /api/host within 30s; see `control-fabs logs`");
}

async function pairingLink(s: State, base: string) {
  const { status, data } = await api(s, "POST", "/api/pairing-links", {});
  if (status !== 200) die(`could not create a pairing link (HTTP ${status}${data?.error ? `: ${data.error}` : ""})`);
  return `${base}/pair?code=${new URL(data.url).searchParams.get("code")}`;
}

function retiredToken(s: State) {
  const file = join(s.dataDir, "access-token");
  return existsSync(file) ? readFileSync(file, "utf8").trim() : "retired-shared-token-stand-in";
}

const cookieValue = (cookie: string) => decodeURIComponent(cookie.slice(cookie.indexOf("=") + 1));

function openSocket(url: string, cookie: string) {
  return new Promise<{ opened: boolean; closed: Promise<number> }>((resolve) => {
    const ws = new WebSocket(url, { headers: { cookie } } as any);
    const closed = new Promise<number>((done) => ws.addEventListener("close", (e) => done(e.code)));
    ws.addEventListener("open", () => resolve({ opened: true, closed }));
    ws.addEventListener("error", () => resolve({ opened: false, closed }));
    setTimeout(() => resolve({ opened: false, closed }), 5000);
  });
}

async function stopServer(s: State) {
  if (!alive(s.pid) || !cmdline(s.pid).includes("server/index.ts")) return false;
  try {
    process.kill(-s.pid, "SIGTERM"); // the server's process group: server + any bot CLIs mid-turn
  } catch {
    process.kill(s.pid, "SIGTERM");
  }
  for (let i = 0; i < 20 && alive(s.pid); i++) await Bun.sleep(150);
  if (alive(s.pid)) process.kill(-s.pid, "SIGKILL");
  return true;
}

const commands: Record<string, () => Promise<void>> = {
  async launch() {
    const existing = loadState(false);
    if (existing && alive(existing.pid)) die(`run ${existing.runId} is still up at ${existing.url}; cleanup first or pass --run`);
    const runId = flag("run-id") ?? `run-${new Date().toISOString().replace(/[-:T]/g, "").slice(0, 14)}`;
    const runDir = join(HOME, runId);
    const port = Number(flag("port") ?? (await freePort(4870)));
    if ((await freePort(port)) !== port) die(`port ${port} is in use`);
    const tailnet = flags.tailnet === true;
    mkdirSync(runDir, { recursive: true });
    let shimDir: string | undefined;
    if (flags["tailscale-shim"] === true) {
      const real = Bun.which("tailscale") ?? die("--tailscale-shim needs the real tailscale CLI for read-only status");
      shimDir = join(runDir, "tailscale-shim");
      mkdirSync(join(shimDir, "bin"), { recursive: true });
      if (!existsSync(join(shimDir, "bin", "tailscale"))) symlinkSync(join(import.meta.dir, "tailscale-shim"), join(shimDir, "bin", "tailscale"));
      writeFileSync(join(shimDir, "real"), real);
    }

    if (flags["no-build"] !== true) {
      process.stdout.write("building web app… ");
      const b = await sh(["bun", "run", "build"]);
      if (b.code !== 0) die(`build failed:\n${b.err || b.out}`);
      console.log("ok");
    }
    const rev = (await sh(["git", "rev-parse", "--short", "HEAD"])).out || "unknown";
    const dirty = (await sh(["git", "status", "--porcelain"])).out ? "+dirty" : "";

    const s: State = {
      runId,
      pid: 0,
      port,
      url: `http://127.0.0.1:${port}`,
      tailnet,
      runDir,
      dataDir: join(runDir, "data"),
      workRoot: join(runDir, "work"),
      artifacts: join(ARTIFACTS_ROOT, runId),
      rev: rev + dirty,
      startedAt: new Date().toISOString(),
      shimDir,
    };
    mkdirSync(s.artifacts, { recursive: true });
    writeFileSync(join(HOME, "current"), runId);
    await startServer(s);
    console.log(`ready  run=${runId}  url=${s.url}  pid=${s.pid}  rev=${s.rev}${tailnet ? "  (+tailnet bind)" : ""}${shimDir ? "  (tailscale serve simulated)" : ""}`);
    console.log(`artifacts → ${s.artifacts}`);
  },

  async server() {
    const s = loadState()!;
    const action = positional[1];
    if (action === "stop") {
      console.log((await stopServer(s)) ? `stopped server ${s.pid}; run data kept` : "server was not running");
    } else if (action === "start") {
      if (alive(s.pid)) die(`server ${s.pid} is still running`);
      if ((await freePort(s.port)) !== s.port) die(`port ${s.port} was taken by another process while the server was stopped; cleanup and launch again with --port`);
      await startServer(s);
      console.log(`ready  run=${s.runId}  url=${s.url}  pid=${s.pid}`);
    } else die("usage: control-fabs server stop|start");
  },

  async doctor() {
    const s = loadState()!;
    let failed = false;
    const line = (level: "ok" | "warn" | "FAIL", msg: string) => {
      if (level === "FAIL") failed = true;
      console.log(`${level.padEnd(4)}  ${msg}`);
    };
    line(alive(s.pid) ? "ok" : "FAIL", `server pid ${s.pid} ${alive(s.pid) ? "running" : "not running"}`);
    if (alive(s.pid) && !cmdline(s.pid).includes("server/index.ts")) line("FAIL", `pid ${s.pid} is not a fabs-bot server`);
    const owners = (await sh(["lsof", "-ti", `tcp:${s.port}`, "-sTCP:LISTEN"])).out.split("\n").filter(Boolean).map(Number);
    line(owners.includes(s.pid) ? "ok" : "FAIL", `port ${s.port} ${owners.includes(s.pid) ? "owned by our server" : `owned by ${owners.join(",") || "nobody"}`}`);
    const host = await api(s, "GET", "/api/host").catch(() => null);
    if (!host || host.status !== 200) line("FAIL", `/api/host → ${host?.status ?? "no answer"}`);
    else {
      line(host.data.workRoot === s.workRoot ? "ok" : "FAIL", `isolated work root ${host.data.workRoot === s.workRoot ? "confirmed" : "MISMATCH: this is not our instance"}`);
      line("ok", `tailscale ${host.data.tailscale.running ? "running" : "not running"}${s.tailnet ? ", instance also bound to tailnet" : ", instance is loopback-only"}`);
      line(s.shimDir || !host.data.serve.enabled ? "ok" : "FAIL", s.shimDir ? "tailscale serve is simulated by the shim" : host.data.serve.enabled ? "Tailscale HTTPS is on without the shim" : "Tailscale HTTPS is off");
    }
    const index = join(REPO, "dist/web/index.html");
    if (!existsSync(index)) line("FAIL", "web build missing (dist/web)");
    else {
      const newest = (dir: string): number =>
        readdirSync(dir, { withFileTypes: true }).reduce((m, e) => {
          const p = join(dir, e.name);
          return Math.max(m, e.isDirectory() ? newest(p) : statSync(p).mtimeMs);
        }, 0);
      const stale = Math.max(newest(join(REPO, "web/src")), newest(join(REPO, "shared"))) > statSync(index).mtimeMs;
      line(stale ? "warn" : "ok", stale ? "web build is older than web/src; relaunch to rebuild" : "web build is fresh");
    }
    const serverSrc = Math.max(...readdirSync(join(REPO, "server"), { recursive: true }).map((f) => statSync(join(REPO, "server", String(f))).mtimeMs));
    if (serverSrc > Date.parse(s.startedAt)) line("warn", "server source changed since launch; relaunch to pick it up");
    const prov = await api(s, "GET", "/api/providers").catch(() => null);
    if (prov?.status === 200) {
      const have = prov.data.filter((p: any) => p.installed).map((p: any) => p.id);
      line(have.includes("claude") ? "ok" : "warn", `agent CLIs installed: ${have.join(", ") || "none"}`);
    }
    if (s.browser) {
      const up = await fetch(`http://127.0.0.1:${s.browser.cdpPort}/json/version`).then((r) => r.ok).catch(() => false);
      const what = s.browser.desktop ? "desktop app" : "browser";
      line(up ? "ok" : "FAIL", `${what} ${up ? `up${s.browser.desktop ? "" : ` (viewport ${s.browser.viewport})`}` : "not answering on CDP; start it again"}`);
    }
    console.log(`run=${s.runId} url=${s.url} rev=${s.rev}`);
    if (failed) process.exit(1);
  },

  async api() {
    const s = loadState()!;
    const [method, path, body] = positional.slice(1);
    if (!method || !path) die("usage: control-fabs api <METHOD> <path> [json]");
    const r = await api(s, method.toUpperCase(), path, body ? JSON.parse(body) : undefined);
    console.log(redact(typeof r.data === "string" ? r.data : JSON.stringify(r.data, null, 2)));
    if (r.status >= 400) process.exit(1);
  },

  async seed() {
    const s = loadState()!;
    const prov = (await api(s, "GET", "/api/providers")).data as { id: string; installed: boolean }[];
    const has = (id: string) => prov.some((p) => p.id === id && p.installed);
    const existing = (await api(s, "GET", "/api/bots")).data as { id: string; name: string }[];
    const fixtures = [
      { name: "Chief", role: "Coordinates the team", shape: "drop", color: "#FF5A00", provider: "claude", model: "claude-haiku-5-5" },
      { name: "Design", role: "Proposes UI and copy", shape: "blob", color: "#111111", provider: "claude", model: "claude-haiku-5-5" },
      { name: "Careful", role: "Asks before acting", shape: "egg", color: "#7B3FF2", provider: "claude", model: "claude-haiku-5-5", autonomy: "ask" },
      { name: "Engineer", role: "Builds code", shape: "hex", color: "#1478FF", provider: "codex", model: "" },
    ].filter((f) => has(f.provider));
    const out: Record<string, string> = {};
    for (const f of fixtures) {
      const found = existing.find((b) => b.name === f.name);
      out[f.name] = found ? found.id : (await api(s, "POST", "/api/bots", f)).data.id;
    }
    console.log(JSON.stringify(out, null, 2));
  },

  async threads() {
    const s = loadState()!;
    for (const t of (await api(s, "GET", "/api/threads")).data)
      console.log(`${t.id}  ${t.kind.padEnd(11)} ${JSON.stringify(t.title)} topic=${JSON.stringify(t.topic)} unread=${t.unread}  ${redact(t.preview).slice(0, 80)}`);
  },

  async thread() {
    const s = loadState()!;
    const id = positional[1] ?? die("usage: control-fabs thread <threadId>");
    const bots = Object.fromEntries(((await api(s, "GET", "/api/bots")).data as any[]).map((b) => [b.id, b.name]));
    for (const m of (await api(s, "GET", `/api/threads/${id}/messages`)).data) {
      const who = m.author === "bot" ? bots[m.botId] ?? "bot" : m.author;
      const parts = m.parts
        .map((p: any) =>
          p.type === "text"
            ? JSON.stringify(p.text.slice(0, 160))
            : p.type === "tool"
              ? `[tool ${p.name} ${p.status}${p.status === "error" && p.summary ? ` ${JSON.stringify(p.summary)}` : ""}]`
              : p.type === "file"
                ? `[file ${p.name} ${p.size}B id=${p.fileId}]`
                : p.type === "question"
                  ? `[question ${JSON.stringify(p.question)} options=${p.options.length} answered=${p.answered ?? "-"}]`
                  : p.type === "screen"
                    ? `[screen ${JSON.stringify(p.reason)} ${p.outcome ?? "pending"}]`
                    : p.type === "webhook"
                      ? `[webhook ${p.state} ${JSON.stringify(p.detail)} request=${p.requestId}]`
                      : p.type === "webhook-setup"
                        ? "[webhook-setup]"
                        : `[approval ${p.tool} ${p.decision ?? "pending"} id=${p.requestId}]`,
        )
        .join(" ");
      console.log(redact(`#${m.seq} ${who} (${m.status}): ${parts}`));
    }
  },

  async wait() {
    const s = loadState()!;
    const id = positional[1] ?? die("usage: control-fabs wait <threadId> --for idle|blocked|question|approval|screen|file|text:<substring>");
    const want = flag("for") ?? "idle";
    const timeout = Number(flag("timeout") ?? 180) * 1000;
    const deadline = Date.now() + timeout;
    const kind = ((await api(s, "GET", "/api/threads")).data as any[]).find((t) => t.id === id)?.kind;
    const isRequest = (m: any) => (kind === "backchannel" ? m.fromBotId !== null : m.author !== "bot");
    let seen = "";
    let stableSince = 0;
    while (Date.now() < deadline) {
      const msgs = (await api(s, "GET", `/api/threads/${id}/messages`)).data as any[];
      const parts = msgs.flatMap((m) => m.parts);
      const running = msgs.some((m) => m.status === "streaming" && !m.parts.some((p: any) => p.type === "approval" && !p.decision));
      const replies = msgs.slice(msgs.findLastIndex(isRequest) + 1);
      const needsYou = parts.some(
        (p) => (p.type === "question" && p.answered === undefined && !p.greeting) || (p.type === "approval" && !p.decision) || (p.type === "screen" && !p.outcome),
      );
      let hit = false;
      if (want === "idle" || want === "blocked") {
        const ended = running || !replies.length ? "" : replies.some((m) => m.status === "error") ? "error" : needsYou ? "blocked" : "idle";
        const snapshot = JSON.stringify(msgs);
        if (snapshot !== seen) [seen, stableSince] = [snapshot, Date.now()];
        if (ended && Date.now() - stableSince > 2500) {
          const how = { idle: "idle", error: "in an error", blocked: "waiting on you" }[ended];
          if (ended !== want) die(`the turn in ${id} ended ${how}, not ${want}; see \`control-fabs thread ${id}\``);
          hit = true;
        }
      } else if (want === "question") hit = parts.some((p) => p.type === "question" && p.answered === undefined && !p.greeting);
      else if (want === "approval") hit = parts.some((p) => p.type === "approval" && !p.decision);
      else if (want === "screen") hit = parts.some((p) => p.type === "screen" && !p.outcome);
      else if (want === "file") hit = parts.some((p) => p.type === "file");
      else if (want.startsWith("text:")) hit = parts.some((p) => p.type === "text" && p.text.toLowerCase().includes(want.slice(5).toLowerCase()));
      else die(`unknown --for ${want}`);
      if (hit) {
        console.log(`ok  ${want} after ${Math.round((timeout - (deadline - Date.now())) / 1000)}s`);
        return;
      }
      await Bun.sleep(1000);
    }
    die(`timed out after ${timeout / 1000}s waiting for ${want} in ${id}`, 2);
  },

  async paths() {
    const s = loadState()!;
    console.log(JSON.stringify({ runDir: s.runDir, dataDir: s.dataDir, workRoot: s.workRoot, artifacts: s.artifacts }, null, 2));
  },

  async logs() {
    const s = loadState()!;
    const lines = readFileSync(join(s.runDir, "server.log"), "utf8").split("\n");
    console.log(redact(lines.slice(-Number(flag("n") ?? 60)).join("\n")));
  },

  async "pair-check"() {
    const s = loadState()!;
    if (!s.tailnet) die("launch with --tailnet to check remote pairing");
    const host = (await api(s, "GET", "/api/host")).data;
    const base = host.tailscale.ip ? `http://${host.tailscale.ip}:${s.port}` : die("tailscale has no IPv4 address");
    const login = host.tailscale.login ?? die("tailscale has no logged-in user");
    const retired = retiredToken(s);
    const expiring = flags.expiry === true ? { link: await pairingLink(s, base), at: Date.now() } : null;
    const pairOnce = async () => {
      const link = await pairingLink(s, base);
      const first = await fetch(link, { redirect: "manual" });
      const again = await fetch(link, { redirect: "manual" });
      const cookie = first.headers.get("set-cookie")?.split(";")[0] ?? "";
      return { first: first.status, again: again.status, cookie, token: cookieValue(cookie) };
    };
    const currentId = async (cookie: string) => (await (await fetch(base + "/api/devices", { headers: { cookie } })).json()).find((d: any) => d.current)?.id;

    const unpaired = await fetch(base + "/api/bots");
    const wrong = await fetch(base + "/pair?code=wrong", { redirect: "manual" });
    const oldLink = await fetch(base + `/pair?token=${retired}`, { redirect: "manual" });
    const a = await pairOnce();
    const b = await pairOnce();
    const paired = await fetch(base + "/api/bots", { headers: { cookie: a.cookie } });
    const query = await fetch(base + `/api/host?token=${a.token}`);
    const bearer = await fetch(base + "/api/host", { headers: { authorization: `Bearer ${a.token}` } });
    const retiredCookie = await fetch(base + "/api/bots", { headers: { cookie: `fabs_token=${retired}` } });
    const retiredBearer = await fetch(base + "/api/bots", { headers: { authorization: `Bearer ${retired}` } });
    const hostText = await (await fetch(base + "/api/host", { headers: { cookie: a.cookie } })).text();
    const listText = await (await fetch(base + "/api/devices", { headers: { cookie: a.cookie } })).text();
    const stored = readFileSync(join(s.dataDir, "devices.json"), "utf8");
    const storedMode = statSync(join(s.dataDir, "devices.json")).mode & 0o777;
    const aId = await currentId(a.cookie);
    const bId = await currentId(b.cookie);
    const socket = await openSocket(base.replace(/^http/, "ws") + "/ws", b.cookie);
    const removal = await api(s, "DELETE", `/api/devices/${bId}`);
    const closeCode = await Promise.race([socket.closed, Bun.sleep(5000).then(() => 0)]);
    const removedApi = await fetch(base + "/api/bots", { headers: { cookie: b.cookie } });
    const keptApi = await fetch(base + "/api/bots", { headers: { cookie: a.cookie } });
    const mcp = await fetch(base + "/mcp/anything", { method: "POST", body: "{}" });
    const ownerHeader = await fetch(s.url + "/api/bots", { headers: { "tailscale-user-login": login } });
    const foreign = { origin: "https://unrelated.example" };
    const crossWs = await fetch(s.url + "/ws", { headers: { ...foreign, connection: "Upgrade", upgrade: "websocket" } });
    const crossPost = await fetch(s.url + "/api/bots", { method: "POST", headers: { ...foreign, "content-type": "text/plain" }, body: '{"name":"Probe"}' });
    const plainPost = await fetch(s.url + "/api/bots", { method: "POST", headers: { "content-type": "text/plain" }, body: '{"name":"Probe"}' });
    const http = (r: Response | { status: number }) => `HTTP ${r.status}`;
    const rows: [string, boolean, string][] = [
      ["unpaired API call is refused", unpaired.status === 401, http(unpaired)],
      ["wrong pairing code is refused", wrong.status === 403, http(wrong)],
      ["an old pairing link carrying the retired shared token is refused", oldLink.status === 403, http(oldLink)],
      ["pairing link sets a device cookie and redirects", a.first === 302 && a.cookie.startsWith("fabs_token="), `HTTP ${a.first}`],
      ["the same pairing link is refused the second time", a.again === 403, `HTTP ${a.again}`],
      ["a second device gets its own token", b.first === 302 && !!b.token && b.token !== a.token, b.token !== a.token ? "different" : "same"],
      ["paired cookie can call the API", paired.status === 200, http(paired)],
      ["device token in ?token= is refused on the API", query.status === 401, http(query)],
      ["device token as a bearer header can call the API", bearer.status === 200, http(bearer)],
      ["the retired shared token is refused as a cookie", retiredCookie.status === 401, http(retiredCookie)],
      ["the retired shared token is refused as a bearer header", retiredBearer.status === 401, http(retiredBearer)],
      ["/api/host carries no pairing link or token", !/pairUrl|code=|token=/.test(hostText), "checked"],
      ["the device list carries no token or token hash", !listText.includes(a.token) && !listText.includes(b.token) && !/token/i.test(listText), `${JSON.parse(listText).length} devices`],
      ["devices.json keeps no token and only its owner can read it", !stored.includes(a.token) && !stored.includes(b.token) && storedMode === 0o600, `mode ${storedMode.toString(8)}`],
      ["a paired device's WebSocket opens", socket.opened, socket.opened ? "open" : "refused"],
      ["removing a device closes its open WebSocket", removal.status === 200 && closeCode === 1008, closeCode ? `close ${closeCode}` : "still open"],
      ["a removed device's cookie is refused", removedApi.status === 401, http(removedApi)],
      ["the other paired device stays signed in", keptApi.status === 200, http(keptApi)],
      ["bot MCP endpoint is loopback-only", mcp.status === 403, http(mcp)],
      ["your own Tailscale login on this PC's port is refused without pairing", ownerHeader.status === 401, http(ownerHeader)],
      ["cross-origin WebSocket upgrade is refused", crossWs.status === 403, http(crossWs)],
      ["cross-origin text/plain write is refused", crossPost.status === 403, http(crossPost)],
      ["non-JSON write is refused", plainPost.status === 415, http(plainPost)],
    ];
    await api(s, "DELETE", `/api/devices/${aId}`);
    if (expiring) {
      console.log("waiting for a pairing link to pass 5 minutes…");
      await Bun.sleep(Math.max(0, expiring.at + 5 * 60_000 + 2_000 - Date.now()));
      const expired = await fetch(expiring.link, { redirect: "manual" });
      rows.push(["a pairing link is refused after 5 minutes", expired.status === 403, http(expired)]);
    }
    const lines = rows.map(([label, pass, detail]) => `${pass ? "ok  " : "FAIL"}  ${label} (${detail})`);
    console.log(lines.join("\n"));
    const out = artifactPath(s, flag("path") ?? "pairing/pair-check.txt");
    writeFileSync(out, lines.join("\n") + "\n");
    console.log(`→ ${out}`);
    if (rows.some(([, pass]) => !pass)) process.exit(1);
  },

  async browser() {
    const s = loadState()!;
    const action = positional[1] ?? die("usage: control-fabs browser <start|open|click|fill|press|wait|snapshot|screenshot|eval|stop> …");
    if (action === "start") return browserStart(s);
    if (action === "stop") return browserStop(s, true);
    if (!s.browser) die("browser not started; run `control-fabs browser start`");
    const job: Record<string, unknown> = {
      repo: REPO,
      action,
      flags,
      positional: positional.slice(2),
      cdpPort: s.browser.cdpPort,
      viewport: s.browser.viewport,
      desktop: !!s.browser.desktop,
      url: s.url,
      artifacts: s.artifacts,
    };
    const wantsPairLink = action === "pair" || flag("value") === "@pair-link";
    if (s.tailnet && (wantsPairLink || flag("via") === "tailnet" || flag("value") === "@tailnet-url")) {
      const host = (await api(s, "GET", "/api/host")).data;
      if (host.tailscale.ip) {
        job.tailnetBase = `http://${host.tailscale.ip}:${s.port}`;
        if (wantsPairLink) job.pairUrl = await pairingLink(s, job.tailnetBase as string);
      }
    }
    const node = Bun.which("node") ?? die("node is required for browser actions (Playwright's CDP client hangs under Bun)");
    const p = Bun.spawn([node, join(import.meta.dir, "browser-driver.mjs")], {
      env: { ...process.env, FABS_BROWSER_JOB: JSON.stringify(job) },
      stdout: "inherit",
      stderr: "inherit",
    });
    const code = await p.exited;
    if (code !== 0) process.exit(code);
  },

  async "serve-shim"() {
    const s = loadState()!;
    if (!s.shimDir) die("launch with --tailscale-shim to simulate tailscale serve");
    const stateFile = join(s.shimDir, "serve.json");
    const shim = existsSync(stateFile) ? JSON.parse(readFileSync(stateFile, "utf8")) : null;
    const action = positional[1] ?? "state";
    if (action === "log") {
      const log = existsSync(join(s.shimDir, "calls.log")) ? readFileSync(join(s.shimDir, "calls.log"), "utf8") : "";
      const lines = log.split("\n").filter((l) => l && !l.startsWith("tailscale status"));
      if (flag("path")) writeFileSync(artifactPath(s, flag("path")!), redact(lines.join("\n")) + "\n");
      console.log(redact(lines.join("\n")) || "(no serve calls yet)");
      return;
    }
    if (!shim) die("the server hasn't asked tailscale about serve yet; open Settings → This PC or toggle Tailscale HTTPS first");
    if (action === "state") {
      const rows: string[] = [];
      for (const [hostPort, web] of Object.entries<any>(shim.cfg.Web ?? {}))
        rows.push(`https :${hostPort.split(":").pop()}  →  ${Object.values<any>(web.Handlers ?? {}).map((h) => h.Proxy).join(", ")}`);
      const text = rows.join("\n") || "(no serve mappings)";
      if (flag("path")) writeFileSync(artifactPath(s, flag("path")!), text + "\n");
      console.log(text);
    } else if (action === "occupy") {
      const port = positional[2] ?? die("usage: serve-shim occupy <port>");
      const host = Object.keys(shim.cfg.Web ?? {})[0]?.split(":")[0] ?? "this-pc";
      shim.cfg.TCP = { ...shim.cfg.TCP, [port]: { HTTPS: true } };
      shim.cfg.Web = { ...shim.cfg.Web, [`${host}:${port}`]: { Handlers: { "/": { Proxy: "http://127.0.0.1:1" } } } };
      writeFileSync(stateFile, JSON.stringify(shim, null, 2));
      console.log(`another app now holds https :${port} (→ http://127.0.0.1:1)`);
    } else if (action === "fail") {
      shim.failNext = positional.slice(2).join(" ") || "permission denied";
      writeFileSync(stateFile, JSON.stringify(shim, null, 2));
      console.log(`the next serve change fails with: ${shim.failNext}`);
    } else die("usage: serve-shim state|log|occupy <port>|fail <stderr> [--path rel.txt]");
  },

  async "serve-check"() {
    const s = loadState()!;
    const host = (await api(s, "GET", "/api/host")).data;
    const login = host.tailscale.login ?? die("tailscale has no logged-in user");
    const retired = retiredToken(s);
    const base = `http://127.0.0.1:${s.port + 1}`;
    const get = (path: string, headers: Record<string, string> = {}) => fetch(base + path, { headers }).then((r) => r.status).catch(() => 0);
    const link = await pairingLink(s, base);
    const pair = await fetch(link, { redirect: "manual" }).catch(() => null);
    const again = await fetch(link, { redirect: "manual" }).then((r) => r.status).catch(() => 0);
    const cookie = pair?.headers.get("set-cookie")?.split(";")[0] ?? "";
    const token = cookieValue(cookie);
    const rows = [
      ["no Tailscale identity (tagged device, Funnel) is refused", await get("/api/bots"), 401],
      ["another tailnet user is refused", await get("/api/bots", { "tailscale-user-login": "someone-else@example.com" }), 401],
      ["your own Tailscale login without pairing is refused", await get("/api/bots", { "tailscale-user-login": login }), 401],
      ["a pairing link opened over HTTPS pairs the device", pair?.status ?? 0, 302],
      ["the same pairing link is refused the second time", again, 403],
      ["a device cookie is admitted", await get("/api/bots", { cookie }), 200],
      ["a device cookie with your Tailscale login is admitted", await get("/api/bots", { cookie, "tailscale-user-login": login }), 200],
      ["a device bearer token is admitted", await get("/api/host", { authorization: `Bearer ${token}` }), 200],
      ["a device token in ?token= is refused", await get(`/api/host?token=${token}`), 401],
      ["the retired shared token is refused", await get("/api/bots", { cookie: `fabs_token=${retired}` }), 401],
      ["bot MCP endpoint refuses Tailscale HTTPS", await fetch(base + "/mcp/anything", { method: "POST", body: "{}", headers: { "tailscale-user-login": login } }).then((r) => r.status).catch(() => 0), 403],
      ["this PC's own loopback stays trusted", await fetch(s.url + "/api/bots").then((r) => r.status), 200],
    ] as const;
    const devices = await fetch(base + "/api/devices", { headers: { cookie } }).then((r) => r.json()).catch(() => []);
    const id = devices.find?.((d: any) => d.current)?.id;
    if (id) await api(s, "DELETE", `/api/devices/${id}`);
    let ok = true;
    const lines = rows.map(([label, status, want]) => {
      ok &&= status === want;
      return `${status === want ? "ok  " : "FAIL"}  ${label} (HTTP ${status || "no answer"})`;
    });
    console.log(lines.join("\n"));
    const out = artifactPath(s, flag("path") ?? "tailscale-https/serve-check.txt");
    writeFileSync(out, lines.join("\n") + "\n");
    console.log(`→ ${out}`);
    if (!ok) process.exit(1);
  },

  async "oauth-mcp"() {
    const s = loadState()!;
    const action = positional[1] ?? "state";
    const running = s.oauthMcp && alive(s.oauthMcp.pid) ? s.oauthMcp : null;
    if (action === "start") {
      if (running) die(`the test OAuth server already runs at http://127.0.0.1:${running.port}; stop it first`);
      const port = Number(flag("port") ?? (await freePort(s.port + 5)));
      if ((await freePort(port)) !== port) die(`port ${port} is in use`);
      const opts = ["--port", String(port), "--ttl", flag("ttl") ?? "60", ...(flags["no-register"] === true ? ["--no-register"] : [])];
      const log = join(s.runDir, "oauth-mcp.log");
      const start = await sh(["sh", "-c", `setsid bun '${join(import.meta.dir, "oauth-mcp.ts")}' ${opts.join(" ")} >> '${log}' 2>&1 < /dev/null & echo $!`]);
      s.oauthMcp = { pid: Number(start.out), port };
      saveState(s);
      for (let i = 0; i < 50; i++) {
        if (await fetch(`http://127.0.0.1:${port}/test/state`).then((r) => r.ok).catch(() => false)) {
          console.log(`test OAuth server up  mcp=http://127.0.0.1:${port}/mcp  nometa=…/nometa/mcp  open=…/open/mcp  ttl=${opts[3]}s${flags["no-register"] === true ? "  client=fabs-test-client secret=fabs-test-secret" : ""}`);
          return;
        }
        await Bun.sleep(100);
      }
      die(`the test OAuth server did not start; see ${log}`);
    }
    if (!running) die("the test OAuth server isn't running; `control-fabs oauth-mcp start` first");
    const base = `http://127.0.0.1:${running.port}`;
    if (action === "stop") {
      stopGroup(running.pid);
      delete s.oauthMcp;
      saveState(s);
      console.log("test OAuth server stopped");
    } else if (action === "expire") {
      console.log(JSON.stringify(await fetch(`${base}/test/expire${flags.refresh === true ? "?refresh" : ""}`, { method: "POST" }).then((r) => r.json())));
    } else if (action === "state") {
      const text = JSON.stringify(await fetch(`${base}/test/state`).then((r) => r.json()));
      if (flag("path")) writeFileSync(artifactPath(s, flag("path")!), text + "\n");
      console.log(text);
    } else if (action === "log") {
      console.log(readFileSync(join(s.runDir, "oauth-mcp.log"), "utf8").trim());
    } else die("usage: control-fabs oauth-mcp start [--port N] [--ttl S] [--no-register] | state [--path rel.txt] | expire [--refresh] | log | stop");
  },

  async "claude-creds"() {
    const file = join(homedir(), ".claude", ".credentials.json");
    const keys = existsSync(file) ? Object.keys(JSON.parse(readFileSync(file, "utf8")).mcpOAuth ?? {}).sort() : [];
    const digest = new Bun.CryptoHasher("sha256").update(JSON.stringify(keys)).digest("hex").slice(0, 16);
    const text = `mcpOAuth entries: ${keys.length}  key fingerprint: ${digest}`;
    const s = loadState(false);
    if (s && flag("path")) writeFileSync(artifactPath(s, flag("path")!), text + "\n");
    console.log(text);
  },

  async desktop() {
    const s = loadState()!;
    const usage = 'usage: control-fabs desktop start [--fresh] | menu "<item label>" | stop';
    const action = positional[1] ?? die(usage);
    if (action === "stop") return browserStop(s, true);
    if (action === "menu") return desktopMenu(s, positional[2] ?? die(usage));
    if (action !== "start") die(usage);
    await desktopStart(s);
  },

  async "privacy-check"() {
    const s = loadState(false);
    const dir = positional[1] ?? s?.artifacts ?? die("usage: control-fabs privacy-check [dir]");
    let problems = 0;
    const walk = (d: string): string[] =>
      readdirSync(d, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(join(d, e.name)) : [join(d, e.name)]));
    for (const f of walk(dir)) {
      if (f.endsWith(".png")) {
        // Images can't be grepped: require an ARIA twin of the same state that is clean.
        const twin = f.replace(/\.png$/, ".aria.txt");
        if (!existsSync(twin)) {
          problems++;
          console.log(`UNCHECKED  ${f}  (no ${twin.split("/").pop()} twin; inspect by eye before sharing)`);
        } else if (risky(readFileSync(twin, "utf8"))) {
          problems++;
          console.log(`RISKY      ${f}  (its ARIA twin mentions tailnet identity)`);
        }
      } else if (risky(readFileSync(f, "utf8"))) {
        problems++;
        console.log(`RISKY      ${f}`);
      }
    }
    console.log(problems ? `${problems} artifact(s) need attention before sharing` : "ok  nothing tailnet-identifying found");
    if (problems) process.exit(1);
  },

  async cleanup() {
    const s = loadState(false);
    if (!s) {
      console.log("nothing to clean up");
      return;
    }
    await browserStop(s, false);
    if (s.oauthMcp) stopGroup(s.oauthMcp.pid);
    if (await stopServer(s)) console.log(`stopped server ${s.pid}`);
    rmSync(s.runDir, { recursive: true, force: true });
    if (currentRunId() === s.runId) rmSync(join(HOME, "current"), { force: true });
    const kept = existsSync(s.artifacts) ? readdirSync(s.artifacts, { recursive: true }).length : 0;
    console.log(`removed ${s.runDir}`);
    console.log(`evidence kept: ${s.artifacts} (${kept} entries)`);
  },

  async help() {
    console.log(`control-fabs: drive an isolated Fabs Bot instance

  launch [--port N] [--tailnet] [--tailscale-shim] [--no-build] [--run-id ID]   build + start; prints url, pid, artifacts dir
  doctor                                                       read-only health check (exit 1 on FAIL)
  seed                                                         create fixture bots (Claude Haiku 5.5; Codex if installed)
  api <METHOD> <path> [json]                                   call the instance's HTTP API
  threads | thread <id>                                        list threads / dump one thread compactly
  wait <threadId> --for idle|blocked|question|approval|screen|file|text:<s> [--timeout 180]   idle/blocked exit 1 when the turn ends otherwise
  paths                                                        print run, data, work-root and artifacts dirs (for side-effect checks)
  logs [--n 60]                                                tail the server log (redacted)
  server stop|start                                            stop this run's server (and any bot CLI mid-turn) or start it again on the same port and data
  pair-check [--expiry] [--path pairing/pair-check.txt]        remote-device auth checks over the tailnet (needs --tailnet; --expiry waits 5 min for a link to expire)
  browser start [--viewport 1440x900|430x932]                  headless Chromium on CDP (restart to change viewport)
  browser open [/path] [--via tailnet] | browser pair
  browser click|fill|press|wait|count|text  --role R --name N | --label L | --text T | --selector S [--nth i] [--exact]  (click: [--at x,y], fractions ≤1 of the target's box)
          fill: --value V (@pair-link mints a one-time link; @pair-link / @tailnet-url type the tailnet link unseen)   press: --key K   wait: --state visible|hidden [--timeout s]
          click --accept-dialog [--dialog-text T]   accept the confirm()/prompt() the click opens
  browser snapshot --path rel.aria.txt [target] | screenshot --path rel.png [--full-page] [--no-mask] | eval '<js>'
          any browser action takes --tab <text> to drive the tab whose address contains <text> (a link opened in a new tab); browser close --tab <text> closes it
  browser stop
  desktop start [--fresh] | desktop menu "<label>" | desktop stop   the Electron app on a headless compositor; browser actions then drive it
  serve-shim state|log|occupy <port>|fail <stderr> [--path rel.txt]   inspect or rig the simulated tailscale serve (needs --tailscale-shim)
  serve-check [--path tailscale-https/serve-check.txt]         auth matrix for the Tailscale HTTPS listener (Tailscale HTTPS must be on)
  oauth-mcp start [--port N] [--ttl S] [--no-register] | state [--path rel.txt] | expire [--refresh] | log | stop
                                                               a loopback MCP server behind OAuth for connector sign-in (stopped by cleanup)
  claude-creds [--path rel.txt]                                read-only: count + fingerprint of the mcpOAuth key names in ~/.claude/.credentials.json
  privacy-check [dir]                                          scan evidence for tailnet hostnames/IPs/tokens
  cleanup                                                      stop what this run started, delete scratch, keep evidence

  Global: --run <id> (or FABS_VERIFY_RUN) targets a specific run. State: ${HOME}`);
  },
};

async function chromePath(): Promise<string> {
  if (process.env.FABS_VERIFY_CHROME) return process.env.FABS_VERIFY_CHROME;
  const cache = join(process.env.HOME ?? "", ".cache/ms-playwright");
  if (existsSync(cache)) {
    const dirs = readdirSync(cache).filter((d) => /^chromium-\d+$/.test(d)).sort((a, b) => Number(b.split("-")[1]) - Number(a.split("-")[1]));
    for (const d of dirs) {
      for (const sub of ["chrome-linux64/chrome", "chrome-linux/chrome", "chrome-mac/Chromium.app/Contents/MacOS/Chromium"]) {
        if (existsSync(join(cache, d, sub))) return join(cache, d, sub);
      }
    }
  }
  for (const bin of ["google-chrome", "google-chrome-stable", "chromium", "chromium-browser"]) {
    const p = Bun.which(bin);
    if (p) return p;
  }
  die("no Chromium found: set FABS_VERIFY_CHROME or run `bunx playwright-core install chromium`");
}

async function browserStart(s: State) {
  await browserStop(s, false);
  const viewport = flag("viewport") ?? "1440x900";
  const [w, h] = viewport.split("x").map(Number);
  if (!w || !h) die("--viewport WxH");
  const cdpPort = await freePort(9330);
  const profile = join(s.runDir, "browser-profile");
  mkdirSync(profile, { recursive: true });
  const chrome = await chromePath();
  const args = [
    "--headless=new",
    `--remote-debugging-port=${cdpPort}`,
    `--user-data-dir=${profile}`,
    `--window-size=${w},${h}`,
    "--hide-scrollbars",
    "--no-first-run",
    "--no-default-browser-check",
    "--disable-gpu",
    ...(w < 820 ? ["--force-device-scale-factor=2"] : []),
    "about:blank",
  ];
  const start = await sh(["sh", "-c", `setsid '${chrome}' ${args.map((a) => `'${a}'`).join(" ")} > '${join(s.runDir, "browser.log")}' 2>&1 < /dev/null & echo $!`]);
  const pid = Number(start.out);
  for (let i = 0; i < 50; i++) {
    if (await fetch(`http://127.0.0.1:${cdpPort}/json/version`).then((r) => r.ok).catch(() => false)) {
      s.browser = { pid, cdpPort, viewport };
      saveState(s);
      console.log(`browser up  viewport=${viewport}  pid=${pid}`);
      return;
    }
    await Bun.sleep(200);
  }
  die("Chromium did not open its CDP port; see browser.log in the run dir");
}

function stopGroup(pid: number) {
  if (!alive(pid)) return;
  try {
    process.kill(-pid, "SIGTERM");
  } catch {
    process.kill(pid, "SIGTERM");
  }
}

async function browserStop(s: State, say: boolean) {
  if (!s.browser) {
    if (say) console.log("browser not running");
    return;
  }
  stopGroup(s.browser.pid);
  if (s.browser.desktop) {
    for (let i = 0; i < 20 && alive(s.browser.pid); i++) await Bun.sleep(150);
    stopGroup(s.browser.desktop.compositorPid);
  }
  const what = s.browser.desktop ? "desktop app" : "browser";
  delete s.browser;
  saveState(s);
  if (say) console.log(`${what} stopped`);
}

/**
 * Electron has no headless mode, so it runs inside a virtual KDE compositor that never reaches the screen.
 * The app gets this run's port and its own data dir; --fresh wipes that dir (saved PCs, cookies).
 */
async function desktopStart(s: State) {
  await browserStop(s, false);
  const kwin = Bun.which("kwin_wayland") ?? die("desktop needs kwin_wayland for a headless display");
  const b = await sh(["bun", "run", "build:desktop"]);
  if (b.code !== 0) die(`desktop build failed:\n${b.err || b.out}`);
  const data = join(s.runDir, "desktop");
  if (flags.fresh === true) rmSync(data, { recursive: true, force: true });
  const socket = `fabs-verify-${s.runId}`;
  const runtime = process.env.XDG_RUNTIME_DIR ?? tmpdir();
  const compositor = await sh(["sh", "-c", `setsid '${kwin}' --virtual --no-lockscreen --socket '${socket}' > '${join(s.runDir, "compositor.log")}' 2>&1 < /dev/null & echo $!`]);
  const compositorPid = Number(compositor.out);
  for (let i = 0; i < 50 && !existsSync(join(runtime, socket)); i++) await Bun.sleep(100);
  if (!existsSync(join(runtime, socket))) die("kwin_wayland did not open its socket; see compositor.log in the run dir");
  const cdpPort = await freePort(9330);
  const inspectPort = await freePort(cdpPort + 1);
  const electron = join(REPO, "node_modules/.bin/electron");
  const env = [`WAYLAND_DISPLAY='${socket}'`, `FABS_PORT=${s.port}`, `FABS_DESKTOP_DATA='${data}'`];
  const args = ["--ozone-platform=wayland", "--disable-gpu", `--remote-debugging-port=${cdpPort}`, `--inspect=127.0.0.1:${inspectPort}`];
  const start = await sh([
    "sh",
    "-c",
    `env -u ELECTRON_RUN_AS_NODE -u DISPLAY ${env.join(" ")} setsid '${electron}' '${REPO}' ${args.join(" ")} > '${join(s.runDir, "desktop.log")}' 2>&1 < /dev/null & echo $!`,
  ]);
  const pid = Number(start.out);
  for (let i = 0; i < 75; i++) {
    const pages = await fetch(`http://127.0.0.1:${cdpPort}/json/list`).then((r) => r.json()).catch(() => []);
    if (pages.some((p: any) => p.type === "page")) {
      s.browser = { pid, cdpPort, viewport: "window", desktop: { compositorPid, inspectPort } };
      saveState(s);
      console.log(`desktop app up  pid=${pid}  (browser actions now drive its window)`);
      return;
    }
    await Bun.sleep(200);
  }
  stopGroup(pid);
  stopGroup(compositorPid);
  die("the desktop app did not open a window; see desktop.log in the run dir");
}

/** Click an item in the desktop app's real application menu, through the main process inspector. */
async function desktopMenu(s: State, label: string) {
  if (!s.browser?.desktop) die("desktop app not started; run `control-fabs desktop start`");
  const targets = await fetch(`http://127.0.0.1:${s.browser.desktop.inspectPort}/json/list`).then((r) => r.json());
  const ws = new WebSocket(targets[0].webSocketDebuggerUrl);
  await new Promise((res, rej) => ((ws.onopen = res), (ws.onerror = rej)));
  const expression = `(() => {
    const { Menu } = process.mainModule.require("electron");
    const find = (items) => items.map((i) => (i.label === ${JSON.stringify(label)} ? i : i.submenu && find(i.submenu.items))).find(Boolean);
    const item = find(Menu.getApplicationMenu().items);
    item?.click();
    return !!item;
  })()`;
  const reply: any = await new Promise((res) => {
    ws.onmessage = (e) => res(JSON.parse(String(e.data)));
    ws.send(JSON.stringify({ id: 1, method: "Runtime.evaluate", params: { expression, returnByValue: true } }));
  });
  ws.close();
  if (reply.result?.result?.value !== true) die(`no menu item labelled ${JSON.stringify(label)}`);
  console.log(`clicked menu item ${label}`);
}

const cmd = positional[0] ?? "help";
const run = commands[cmd] ?? (() => die(`unknown command ${cmd}; try \`control-fabs help\``));
await run();
