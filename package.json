{
  "name": "fabs-bot",
  "version": "0.1.0-alpha.9",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun run build && bun server/index.ts",
    "serve": "bun server/index.ts",
    "build:desktop": "bun build desktop/main.ts desktop/preload.ts desktop/pc-preload.ts --outdir dist/desktop --entry-naming [name].cjs --target node --format cjs --external electron",
    "desktop": "bun run build && bun run build:desktop && env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-hard-break": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
